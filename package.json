{
  "name": "idd-iklim-krizi",
  "private": true,
  "description": "Climate crisis page (/iklimkrizi) for iklimdd.org; copied into the Laravel site (dogantatarjr/idd-org).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"public/assets/iklim-krizi/css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
